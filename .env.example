############################################################
# 1. Wallet & Keys
############################################################
SOLANA_PRIVATE_KEY=
ROBINHOOD_PRIVATE_KEY=

############################################################
# 2. Network & RPC Endpoints
############################################################
# Solana Network
SOLANA_RPC_URL=https://solana-rpc.publicnode.com,https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://solana-rpc.publicnode.com
SOLANA_EXECUTION_RPC_URL=https://mainnet.helius-rpc.com/?api-key=<HELIUS_API_KEY>

# Robinhood Chain (ID: 4663)
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_WS_URL=wss://robinhood-mainnet.g.alchemy.com/v2/<ALCHEMY_KEY>
ROBINHOOD_BLOCKSCOUT_API_KEY=

# External Data APIs
NANSEN_API_KEY=

############################################################
# 3. Mode & Chain Toggles
############################################################
DRY_RUN=true
SIM_INITIAL_BALANCE=100.0
LIVE_ROBINHOOD_ENABLED=false
ENABLE_SOLANA=true
ENABLE_ROBINHOOD=false

############################################################
# 4. Ingestion & Polling Timing
############################################################
STREAM_POLL_INTERVAL_MS=500

############################################################
# 5. Trading Sizing & Entry Gating
############################################################
POSITION_SIZE_USD=15.0
MIN_WHALE_BUY_USD=250.0
MAX_PRICE_DELTA_PCT=5.0
MAX_PRICE_IMPACT_PCT=15.0
MIN_LIQUIDITY_USD=30000.0
MIN_MARKET_CAP_USD=50000.0
MAX_MARKET_CAP_USD=20000000.0
CONFLUENCE_MODE=ALL_TIERS_SOLO

############################################################
# 6. Exit Policy & Risk Management (50-25-25 Protocol)
############################################################
# Stop Loss & Take Profit
STOP_LOSS_PCT=35.0
TAKE_PROFIT_PCT=100.0
TAKE_PROFIT_2_PCT=300.0
TRAILING_STOP_PCT=10.0
TRAILING_STOP_TRIGGER_PCT=35.0

# Runner & Moonbag Protection
LIQUIDITY_DRAIN_USD=10000.0
PEAK_DRAWDOWN_PCT=50.0
PROFIT_LOCK_FLOOR_PCT=20.0
WHALE_FULL_DUMP_PCT=95.0
SHADOW_EXIT_ENABLED=true

# Quarantine & Demotion Guards
QUARANTINE_BASE_MINUTES=15
QUARANTINE_MAX_MINUTES=240
DEMOTE_CONSECUTIVE_LOSSES=2
DEMOTE_CATASTROPHIC_LOSS_PCT=30.0

############################################################
# 7. Robinhood Specific Scanning & Probe Parameters
############################################################
ROBINHOOD_DRY_RUN_TOKEN=
ROBINHOOD_DRY_RUN_SYMBOL=AC
ROBINHOOD_TRADE_AMOUNT_WEI=
ROBINHOOD_SCAN_BLOCKS=50000
ROBINHOOD_SCAN_CHUNK=2000
ROBINHOOD_WALLET_ADDRESS=
ROBINHOOD_TOKEN_ADDRESS=
ROBINHOOD_POOL_INIT_BLOCK=
ROBINHOOD_SEQUENCER_FEED_URL=wss://feed.mainnet.chain.robinhood.com

############################################################
# 8. Storage & IPC
############################################################
TRADING_DB_PATH=data/trading_state.db
WALLET_DB_PATH=data/wallet_registry.db
CANDIDATE_DB_PATH=/absolute/path/to/zenithsw/data/candidate_wallet_registry.db
IPC_SOCKET_PATH=/tmp/zenithsw.sock
