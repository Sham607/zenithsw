# ZENITHSW - SMART MONEY SHADOW ENGINE CONFIGURATION

# Solana SVM Endpoints (Helius Dedicated RPC)
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=***
SOLANA_WS_URL=wss://mainnet.helius-rpc.com/?api-key=***
SOLANA_PRIVATE_KEY=

# Arbitrum EVM Endpoints (Alchemy Private RPC)
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/demo
ARBITRUM_WS_URL=wss://arb-mainnet.g.alchemy.com/v2/demo

# Base EVM Endpoints (Alchemy Private RPC)
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/demo
BASE_WS_URL=wss://base-mainnet.g.alchemy.com/v2/demo
EVM_PRIVATE_KEY=

# Ingestion & Synchronization Interval
FOMO_SYNC_INTERVAL_SEC=5
STREAM_POLL_INTERVAL_MS=500

# Gating & Confluence Rules
MAX_PRICE_DELTA_PCT=5.0
MIN_LIQUIDITY_USD=30000.0
POSITION_SIZE_USD=15.0
TRAILING_STOP_PCT=10.0
STOP_LOSS_PCT=15.0
TAKE_PROFIT_PCT=50.0
SHADOW_EXIT_ENABLED=true
CONFLUENCE_MODE=TIER_S_OR_DUAL_A
DRY_RUN=true

# Persistence & IPC Paths
DB_PATH=data/smart_wallets.db
IPC_SOCKET_PATH=/tmp/zenithsw.sock
