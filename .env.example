# Salin ke .env lalu isi nilainya. Jangan commit .env.
# Endpoint RPC/WS wajib berasal dari secret manager atau environment.
SOLANA_RPC_URLS=https://solana-rpc.publicnode.com,https://rpc.ankr.com/solana,https://api.mainnet-beta.solana.com
SOLANA_RPC_URL=https://solana-rpc.publicnode.com
SOLANA_WS_URL=wss://your-solana-provider.example/ws
# RPC utama Robinhood Chain (chain ID 4663); isi di .env lokal.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_WS_URL=wss://robinhood-mainnet.g.alchemy.com/v2/<ALCHEMY_KEY>
ROBINHOOD_BLOCKSCOUT_API_KEY=

# Credentials opsional sesuai mode yang digunakan
SOLANA_PRIVATE_KEY=
# Robinhood EVM key; never commit .env or print this value.
ROBINHOOD_PRIVATE_KEY=
# Legacy alias accepted only as fallback:
EVM_PRIVATE_KEY=
FOMO_AUTH_TOKEN=
NANSEN_API_KEY=
SOLANATRACKER_API_KEY=

# Trading mode: pertahankan true selama dry-run
DRY_RUN=true
# Gate tambahan; live Robinhood tetap fail-closed sampai executor lengkap.
LIVE_ROBINHOOD_ENABLED=false
ENABLE_SOLANA=true
ENABLE_ROBINHOOD=false
# Hanya Solana dan Robinhood didukung; Base/Arbitrum/Ethereum tidak digunakan.

# Parameter runtime
FOMO_SYNC_INTERVAL_SEC=60
STREAM_POLL_INTERVAL_MS=500
MAX_PRICE_DELTA_PCT=5.0
MIN_LIQUIDITY_USD=30000.0
POSITION_SIZE_USD=15.0
MIN_WHALE_BUY_USD=250.0
MAX_PRICE_IMPACT_PCT=15.0
MIN_MARKET_CAP_USD=50000.0
MAX_MARKET_CAP_USD=20000000.0
TRAILING_STOP_PCT=10.0
STOP_LOSS_PCT=15.0
TAKE_PROFIT_PCT=50.0
SHADOW_EXIT_ENABLED=true
CONFLUENCE_MODE=TIER_S_OR_DUAL_A
TRADING_DB_PATH=data/trading_state.db
WALLET_DB_PATH=data/wallet_registry.db
# Gunakan path absolut pada supervisor/systemd; path relatif dinormalisasi terhadap working directory.
CANDIDATE_DB_PATH=/absolute/path/to/zenithsw/data/candidate_wallet_registry.db
IPC_SOCKET_PATH=/tmp/zenithsw.sock

# Config loader fail-closed: boolean harus true/false; angka harus finite dan > 0.
# ENABLE_BASE=true ditolak; hanya Solana dan Robinhood yang didukung.

# Parameter probe/runtime opsional; angka invalid atau address EVM invalid ditolak.
ROBINHOOD_SCAN_BLOCKS=50000
ROBINHOOD_SCAN_CHUNK=2000
ROBINHOOD_TRADE_AMOUNT_WEI=
ROBINHOOD_WALLET_ADDRESS=
ROBINHOOD_TOKEN_ADDRESS=
ROBINHOOD_DRY_RUN_TOKEN=
ROBINHOOD_DRY_RUN_SYMBOL=AC
ROBINHOOD_POOL_INIT_BLOCK=
ROBINHOOD_SEQUENCER_FEED_URL=wss://feed.mainnet.chain.robinhood.com
# Public RPC resmi rate-limited; gunakan provider ber-SLA untuk production.
# Chain ID mainnet Robinhood: 4663 (0x1237).

# Catatan: TAKE_PROFIT_PCT/STOP_LOSS_PCT/trailing stop adalah policy trading.
# Nilainya sengaja tidak diubah oleh config-hardening ini.
# Nilai harus disepakati terpisah sebelum mode live.

# Referensi resmi:
# https://docs.robinhood.com/chain/connecting/
# https://robinhood.com/us/en/support/articles/robinhood-chain-mainnet/

# Tidak ada fallback otomatis untuk endpoint RPC yang gagal DNS/TLS.
# Perbaiki endpoint di secret manager/.env secara eksplisit.

# END CONFIG TEMPLATE

# ENABLE_BASE=true ditolak; hanya Solana dan Robinhood yang didukung.
